{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aptis English Learning",
  "version": "0.1.0",
  "identifier": "com.aptis.english-learning",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Aptis English Learning",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/duongMyColor/app-ATP-Releases/refs/heads/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMUE5QzkzNzI4MzM5Q0EKUldUS09ZTnlrNXdhb1plQVd3QzA0M2UxVHpodkVtVmJtWjdmdEpTV1JMYlZDOXJ1Wlg1d0Rkek8K"
    }
  }
}